                return value, stats

        return [], stats

    if isinstance(raw, tuple):
        for value in raw:
            if isinstance(value, list):
                return value, stats
        return [], stats

    if isinstance(raw, list):
        # If this is already a list of account dicts, use it. If it is a wrapper list,
