{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hossagent-product-demo-edge",
  "main": "edge/worker.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./edge/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "hossagent.net/*",
      "zone_name": "hossagent.net"
    }
  ],
  "observability": {
    "enabled": true
  }
}
